# cook your dish here
T=int (input ())
for i in range(T):
    N=int(input())
    last_digit = N % 10
    
    # Get the first digit
    first_digit = N
    while first_digit >= 10:
        first_digit //= 10
        
    # Print the sum of first and last digit
    print(first_digit + last_digit)